# Supabase (optional - app works without it using dev mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SIP Configuration (SignalWire, Telnyx, Twilio, or any SIP provider)
VITE_SIP_URI=sip:your-extension@your-domain.sip.signalwire.com
VITE_SIP_PASSWORD=your-sip-password
VITE_SIP_WS_URL=wss://your-domain.sip.signalwire.com
VITE_SIP_CALLER_ID=+1XXXXXXXXXX

# Self-hosted backend (optional - for SQLite mode)
VITE_API_URL=
